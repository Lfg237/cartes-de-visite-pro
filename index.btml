<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cartes Pro</title>

<style>
body{
margin:0;
background:#0b1220;
font-family:Arial;
display:flex;
flex-direction:column;
align-items:center;
color:#fff;
}

.controls{
margin:10px;
display:flex;
gap:6px;
flex-wrap:wrap;
}

button{
background:gold;
border:none;
padding:8px 10px;
border-radius:6px;
font-weight:bold;
cursor:pointer;
color:#000;
}

.card{
width:340px;
height:220px;
border-radius:14px;
display:none;
position:relative;
overflow:hidden;
padding:12px;
box-shadow:0 10px 30px rgba(0,0,0,0.5);
flex-direction:column;
justify-content:space-between;
}

.active{display:flex}

/* LOGO */
.logo{
width:45px;
height:45px;
border-radius:8px;
overflow:hidden;
}
.logo img{
width:100%;
height:100%;
object-fit:cover;
}

/* TEXT */
.company{font-weight:bold;color:gold;font-size:14px;}
.name{font-weight:bold;}
.title{font-size:12px;color:#ccc;}
.services{font-size:10px;color:#ddd;}

/* ACTIONS */
.actions{
display:flex;
flex-direction:column;
gap:4px;
}

.btn-item{
display:flex;
align-items:center;
gap:6px;
}

.btn{
width:22px;
height:22px;
border-radius:50%;
background:gold;
display:flex;
align-items:center;
justify-content:center;
font-size:11px;
color:#000;
}

.btn-input{
width:120px;
font-size:10px;
padding:2px 5px;
border-radius:5px;
border:none;
background:rgba(255,255,255,0.15);
color:#fff;
}

/* BACKGROUNDS */
.m1{background:linear-gradient(135deg,#001018,#003a66,#00aaff);}
.m2{background:radial-gradient(circle at top,#0b3a1b,#05210f,#020a06);}
.m3{background:linear-gradient(135deg,#000,#3a0ca3,#7209b7);}

/* SIGNATURE */
.signature{
position:absolute;
bottom:6px;
right:8px;
font-size:8px;
opacity:0.8;
}
</style>
</head>

<body>

<div class="controls">
<button onclick="selectCard(0)">1</button>
<button onclick="selectCard(1)">2</button>
<button onclick="selectCard(2)">3</button>

<button onclick="logoInput.click()">📷</button>
<button onclick="toggleEdit()">✏️</button>
<button onclick="openPopup()">📄 PDF</button>
</div>

<input type="file" id="logoInput" hidden>

<!-- POPUP -->
<div id="popup" style="display:none;position:fixed;inset:0;background:#000c;justify-content:center;align-items:center;">
<div style="background:#fff;color:#000;padding:20px;border-radius:10px;">
<input id="code" placeholder="Code 233">
<br><br>
<button onclick="checkCode()">OK</button>
<button onclick="closePopup()">Retour</button>
</div>
</div>

<!-- ===== CARTE 1 ===== -->
<div class="card m1 active">
<div class="logo"><img src="https://via.placeholder.com/45"></div>

<div class="company edit">Entreprise Luxe</div>
<div class="services edit">Design • Branding</div>

<div class="actions">
<div class="btn-item">
<a class="link wa" target="_blank"><div class="btn">💬</div></a>
<input class="btn-input" placeholder="+237...">
</div>

<div class="btn-item">
<a class="link tel"><div class="btn">📞</div></a>
<input class="btn-input" placeholder="+237...">
</div>

<div class="btn-item">
<a class="link mail"><div class="btn">✉️</div></a>
<input class="btn-input" placeholder="email@mail.com">
</div>

<div class="btn-item">
<a class="link site" target="_blank"><div class="btn">🌐</div></a>
<input class="btn-input" placeholder="https://...">
</div>
</div>

<div class="name edit">Jean Dupont</div>
<div class="title edit">CEO</div>

<div class="signature">
Ets Lesfacilitateurs Groupe<br>
WhatsApp: +237670035609
</div>
</div>

<!-- ===== CARTE 2 ===== -->
<div class="card m2">
<div class="logo"><img src="https://via.placeholder.com/45"></div>

<div class="company edit">Business Pro</div>
<div class="services edit">Conseil • Gestion</div>

<div class="actions">
<div class="btn-item">
<a class="link wa" target="_blank"><div class="btn">💬</div></a>
<input class="btn-input" placeholder="+237...">
</div>

<div class="btn-item">
<a class="link tel"><div class="btn">📞</div></a>
<input class="btn-input" placeholder="+237...">
</div>

<div class="btn-item">
<a class="link mail"><div class="btn">✉️</div></a>
<input class="btn-input" placeholder="email@mail.com">
</div>

<div class="btn-item">
<a class="link site" target="_blank"><div class="btn">🌐</div></a>
<input class="btn-input" placeholder="https://...">
</div>
</div>

<div class="name edit">Marie Paul</div>
<div class="title edit">Manager</div>

<div class="signature">
Ets Lesfacilitateurs Groupe<br>
WhatsApp: +237670035609
</div>
</div>

<!-- ===== CARTE 3 ===== -->
<div class="card m3">
<div class="logo"><img src="https://via.placeholder.com/45"></div>

<div class="company edit">Creative Studio</div>
<div class="services edit">UI/UX • Design</div>

<div class="actions">
<div class="btn-item">
<a class="link wa" target="_blank"><div class="btn">💬</div></a>
<input class="btn-input" placeholder="+237...">
</div>

<div class="btn-item">
<a class="link tel"><div class="btn">📞</div></a>
<input class="btn-input" placeholder="+237...">
</div>

<div class="btn-item">
<a class="link mail"><div class="btn">✉️</div></a>
<input class="btn-input" placeholder="email@mail.com">
</div>

<div class="btn-item">
<a class="link site" target="_blank"><div class="btn">🌐</div></a>
<input class="btn-input" placeholder="https://...">
</div>
</div>

<div class="name edit">Alex Tech</div>
<div class="title edit">Designer</div>

<div class="signature">
Ets Lesfacilitateurs Groupe<br>
WhatsApp: +237670035609
</div>
</div>

<script>

let cards=document.querySelectorAll(".card");
let edit=false;

function selectCard(i){
cards.forEach(c=>c.classList.remove("active"));
cards[i].classList.add("active");
}

function toggleEdit(){
edit=!edit;
document.querySelectorAll(".edit").forEach(e=>{
e.contentEditable=edit;
});
}

/* LOGO */
logoInput.onchange=e=>{
let r=new FileReader();
r.onload=()=>document.querySelectorAll(".logo img").forEach(i=>i.src=r.result);
r.readAsDataURL(e.target.files[0]);
};

/* LIENS */
function updateLinks(){
document.querySelectorAll(".btn-item").forEach(item=>{
let input=item.querySelector(".btn-input").value;
let link=item.querySelector("a");

if(link.classList.contains("wa")) link.href="https://wa.me/"+input.replace("+","");
if(link.classList.contains("tel")) link.href="tel:"+input;
if(link.classList.contains("mail")) link.href="mailto:"+input;
if(link.classList.contains("site")) link.href=input;
});
}

document.querySelectorAll(".btn-input").forEach(i=>{
i.addEventListener("input",updateLinks);
});

/* POPUP */
function openPopup(){popup.style.display="flex";}
function closePopup(){popup.style.display="none";}

function checkCode(){
if(code.value==="233"){closePopup();exportPDF();}
else alert("Code faux");
}

/* PDF */
function exportPDF(){
let s=document.createElement("script");
s.src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js";
s.onload=()=>html2pdf().from(document.body).save();
document.body.appendChild(s);
}

</script>

</body>
</html>